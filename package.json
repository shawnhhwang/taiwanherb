{
  "name": "taiwanherb",
  "version": "2.0.0",
  "description": "台灣本草植物 Wiki 資料庫系統 - Node.js + Vue.js 架構",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently \"node server/server.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "test": "node tests/api.test.js"
  },
  "keywords": [
    "taiwan-herb",
    "chinese-medicine",
    "wiki",
    "nodejs",
    "express",
    "vue3"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
